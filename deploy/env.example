# Settings for the self-hosted stack (docker-compose.yml). ./deploy/setup.sh copies this to .env
# and fills in the passwords. Restart after changes: docker compose up -d

# --- Database (generated; keep them secret) -------------------------------------------------
POSTGRES_PASSWORD=__GENERATED__
RFP_DB_PASSWORD=__GENERATED__

# --- Where people open the app ---------------------------------------------------------------
# The exact address in the browser bar. Writes from any other origin are refused.
PUBLIC_URL=http://localhost:3000
HTTP_BIND=127.0.0.1          # 0.0.0.0 to open port HTTP_PORT to your network
HTTP_PORT=3000

# HTTPS with your own domain (docker compose --profile https up -d). Point the domain's DNS here,
# then set all five:
# SITE_ADDRESS=rfp.example.com
# PUBLIC_URL=https://rfp.example.com
# COOKIE_SECURE=true
# FRONTEND_HTTPS=true        # needs a rebuild: docker compose up -d --build
# FORWARDED_HOPS=1           # Caddy reports each visitor's address (per-address login limits)

# --- AI provider -----------------------------------------------------------------------------
# Option A: Claude (documents are sent to Anthropic's API)
RFP_LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Option B: a model on your own hardware (docker compose --profile local-ai up -d)
# RFP_LLM_PROVIDER=openai_compatible
# RFP_OPENAI_MODEL=qwen3:32b
# RFP_OPENAI_BASE_URL=http://ollama:11434/v1   # or any OpenAI-compatible server you already run
# WORKER_THREADS=1                              # one job at a time suits a single GPU

# --- Accounts --------------------------------------------------------------------------------
RFP_ALLOW_SIGNUP=true        # set false after your company has signed up; add people by invite
