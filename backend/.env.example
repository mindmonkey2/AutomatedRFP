# Copy to backend/.env and fill in.

# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Postgres. Must be a regular role (not superuser) so row-level security is enforced.
RFP_DATABASE_URL=postgresql+psycopg://rfp:rfp@localhost:5432/rfp

# Sign-in
# RFP_ALLOW_SIGNUP=true          # false = only invited users can join
# RFP_COOKIE_SECURE=false        # set true when served over HTTPS
# RFP_FORWARDED_HOPS=1           # behind nginx/Caddy/a load balancer: limit failed logins per visitor address
# RFP_CORS_ORIGINS=["http://localhost:3000"]   # frontend origin(s) allowed to make changes

# Which AI to use: "claude" (default) or "openai_compatible" (your own models via Ollama, vLLM,
# llama.cpp server, LM Studio, or any OpenAI-compatible endpoint; documents stay on your servers)
# RFP_LLM_PROVIDER=claude

# Self-hosted model settings (when RFP_LLM_PROVIDER=openai_compatible)
# RFP_OPENAI_BASE_URL=http://localhost:11434/v1
# RFP_OPENAI_MODEL=qwen3:32b
# RFP_OPENAI_API_KEY=                 # only for hosted endpoints that need one
# RFP_OPENAI_TIMEOUT_S=900
# RFP_OPENAI_OUTPUT_MODE=json_schema  # json_object or prompt for servers without schema support
# RFP_DRAFT_WORKERS=1                 # answers drafted in parallel (4 by default)

# Document limits (a hostile or huge file is refused instead of exhausting the server)
# RFP_MAX_PDF_PAGES=2000
# RFP_MAX_SHEET_ROWS=100000
# RFP_MAX_UNZIPPED_MB=300               # DOCX/XLSX unpacked size
# RFP_EXTRACTION_WINDOW_CHARS=40000   # lower this for models with a short context window

# Claude settings (defaults shown)
# RFP_MODEL=claude-opus-5-5
# RFP_EFFORT=high
# RFP_USE_FALLBACKS=true
# RFP_REVIEW_THRESHOLD=0.6
